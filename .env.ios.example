# Client-visible service URLs only. Copy to .env.ios.local (ignored by Git).
# NetEase: leave empty for built-in device-direct login/search/playback; no server required.
# Personal AI: configure in Settings → Connections & integrations → Personal AI connection.
# No Folia backend required for personal AI; never put its key in build variables.
# Other services: configure here or inside Settings → Connections on the iPad.
VITE_FOLIA_API_BASE=
VITE_NETEASE_API_BASE=
VITE_KUGOU_API_BASE=
VITE_QQ_API_BASE=
VITE_AI_PROVIDER=google
# Never put GEMINI_API_KEY, OPENAI_API_KEY, QQ_SESSION_SECRET or account tokens here.

# Optional adapter provided under deploy/ipados-bodian; this is not a public service.
VITE_BODIAN_API_BASE=

# External companion services only; iPad localhost is not the Mac.
VITE_NOWPLAYING_API_BASE=
VITE_PLAYERCAP_API_BASE=
